# Copie para .env e preencha:  cp .env.example .env

# Página do ingresso (o link que vai na mensagem)
TICKET_URL=https://buyticketbrasil.com/event/bts-2026worldtourarirang/session/7dbb3a2b-985d-4bf2-9d36-df893169e098?returnTo=%2Fsearch

# Faixa de preço desejada (em reais)
MIN_PRICE=300
MAX_PRICE=900

# Opcional: só considerar ofertas cujo texto contenha esta palavra (ex.: Pista, Cadeira, Meia)
SECTOR_KEYWORD=

# Opcional: seletor CSS do elemento de preço, se a detecção automática pegar coisas demais
PRICE_SELECTOR=

# Intervalo entre verificações no modo loop (segundos)
INTERVAL_SECONDS=120

# Resumo diário no WhatsApp (hora de Brasília); "off" desliga
SUMMARY_HOUR=10

# Avisa no WhatsApp se não conseguir ler a página por N tentativas seguidas
FAIL_ALERT_AFTER=5

# ---- WhatsApp ----
# "callmebot" (grátis, mais simples) ou "twilio"
WHATSAPP_PROVIDER=callmebot
# Seu número com código do país, ex.: +5511999998888
WHATSAPP_PHONE=+55

# CallMeBot: chave recebida no WhatsApp (veja o README)
CALLMEBOT_APIKEY=

# Twilio (só se WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
