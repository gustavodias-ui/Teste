{
  "manifest_version": 3,
  "name": "Monitor de Ingressos",
  "version": "1.0.0",
  "description": "Acompanha o preço dos ingressos direto na página do site e avisa no WhatsApp quando entra na sua faixa.",
  "permissions": ["alarms", "storage", "tabs", "scripting", "notifications"],
  "host_permissions": [
    "https://buyticketbrasil.com/*",
    "https://*.buyticketbrasil.com/*",
    "https://api.callmebot.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "dashboard.html", "default_title": "Monitor de ingressos" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
